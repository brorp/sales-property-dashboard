PORT=3001
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_VERCEL_PREVIEW=false
CORS_ROOT_DOMAINS=propertylounge-cms.com
APP_ROOT_DOMAINS=propertylounge-cms.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/property_lounge

BETTER_AUTH_SECRET=replace-this-secret
BETTER_AUTH_URL=http://localhost:3001

# Fallback only. Saat WA_PROVIDER=qr_local dan session sudah connect,
# nomor aktif otomatis mengikuti akun WhatsApp yang discan.
PROPERTY_LOUNGE_WA=+620000000000
WHATSAPP_VERIFY_TOKEN=dev-verify-token

DISTRIBUTION_POLL_MS=15000
GOOGLE_CALENDAR_MOCK=true
LEADS_EXPORT_ACCESS_CODE=change-me
DAILY_TASK_WORKER_POLL_MS=3600000
IDEMPOTENCY_TTL_MS=20000
IDEMPOTENCY_PROCESSING_TIMEOUT_MS=45000
BROADCAST_MIN_INTERVAL_SECONDS=8
BROADCAST_RANDOM_JITTER_SECONDS=4
WA_OUTBOUND_MIN_DELAY_MS=8000
WA_OUTBOUND_RANDOM_JITTER_MS=4000
REDIS_URL=
WA_QUEUE_ENABLED=false
WA_QUEUE_MIN_DELAY_MS=5000
WA_QUEUE_MAX_DELAY_MS=20000
WA_QUEUE_LOCK_DURATION_MS=120000
WA_QUEUE_WAIT_TIMEOUT_MS=180000
WA_WEBJS_SEND_TIMEOUT_MS=60000
WA_WEBJS_AUTH_TIMEOUT_MS=120000
WA_QR_HEALTHCHECK_MS=60000
WA_QR_HEALTHCHECK_TIMEOUT_MS=15000
WA_QR_HEALTHCHECK_FAILURE_THRESHOLD=5
WA_QR_HEALTH_RECOVERY_COOLDOWN_MS=600000
WA_QR_CLIENT_DESTROY_TIMEOUT_MS=10000
WA_WEBJS_AUTH_FAILURE_RETRY_MS=60000
WA_MISSED_MESSAGE_RECOVERY_INTERVAL_MS=120000
WA_MISSED_RECOVERY_FAILURE_THRESHOLD=1
WA_OUTBOX_POLL_MS=15000
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# WhatsApp provider: dummy | qr_local | cloud_api
WA_PROVIDER=dummy

# For WA_PROVIDER=qr_local
# Wajib beda per workspace/process. Contoh:
# WR: .wa-qr-auth-wr / wa-wr
# WV: .wa-qr-auth-wv / wa-wv
WA_QR_AUTH_PATH=.wa-qr-auth-local
WA_ACTIVE_CLIENT_SLUG=widari
WA_EXPECTED_NUMBER=+620000000000
WA_WEBJS_CLIENT_ID=wa-local
WA_WEBJS_WEB_VERSION=
WA_WEBJS_WEB_VERSION_CACHE_PATH=.wa-web-cache-local
WA_WEBJS_RUNTIME_PATH=.wa-runtime-local
WA_WEBJS_HEADLESS=true
WA_WEBJS_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
WA_WEBJS_PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--no-zygote,--single-process,--disable-gpu
# Optional. Hanya dipakai kalau pilih flow "Link with phone number" (pairing code),
# bukan untuk scan QR biasa.
WA_PAIRING_PHONE=
ADMIN_WHATSAPP_TOKEN=

# For WA_PROVIDER=cloud_api
WA_CLOUD_API_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v21.0

# Firebase Admin SDK (push notification)
# Paste JSON string dari Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=sales-property-web-firebase-adminsdk-fbsvc-0caf0cd6e1.json
